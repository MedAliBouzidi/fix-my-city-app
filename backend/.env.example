# ──────────────────────────────────────────────
# FixMyCity Backend — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Server Runtime
PORT=4000
NODE_ENV=development

# Database (MySQL 8.0)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=fixmycity
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400s

# AWS Integration
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_SNS_TOPIC_ARN=

# Seed Script (used by npm run seed)
SEED_ADMIN_PASSWORD=your_admin_password
SEED_AGENT_PASSWORD=your_agent_password
SEED_TECHNICIAN_PASSWORD=your_technician_password
SEED_CITIZEN_PASSWORD=your_citizen_password
