# ──────────────────────────────────────────────
# FixMyCity Backend — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Server Runtime
PORT=__PORT__
NODE_ENV=__NODE_ENV__

# Database (MySQL 8.0)
DATABASE_HOST=__DATABASE_HOST__
DATABASE_PORT=__DATABASE_PORT__
DATABASE_USER=__DATABASE_USER__
DATABASE_PASSWORD=__DATABASE_PASSWORD__
DATABASE_NAME=__DATABASE_NAME__
DATABASE_SYNCHRONIZE=__DATABASE_SYNCHRONIZE__
DATABASE_LOGGING=__DATABASE_LOGGING__

# Authentication
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRATION=__JWT_EXPIRATION__

# AWS Integration
AWS_REGION=__AWS_REGION__
AWS_S3_BUCKET_NAME=__AWS_S3_BUCKET_NAME__
AWS_SNS_TOPIC_ARN=__AWS_SNS_TOPIC_ARN__

# Seed Script (used by npm run seed)
SEED_ADMIN_PASSWORD=__SEED_ADMIN_PASSWORD__
SEED_AGENT_PASSWORD=__SEED_AGENT_PASSWORD__
SEED_TECHNICIAN_PASSWORD=__SEED_TECHNICIAN_PASSWORD__
SEED_CITIZEN_PASSWORD=__SEED_CITIZEN_PASSWORD__
